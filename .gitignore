# Editor / OS
.DS_Store
.vscode/
.idea/
*.swp
Thumbs.db

# Local notes (公開対象外)
NOTES_LOCAL.md
*.local.md

# Session terminal logs / conversation fragments (公開対象外)
conversation-*.txt
conversation-*.log

# ===========================
# Unity (Stage 3 で initialize 後に有効化)
# ===========================
# https://github.com/github/gitignore/blob/main/Unity.gitignore 準拠

[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS / MD / Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# ===========================
# Blender
# ===========================
*.blend1
*.blend2
*.blend@
*.blend.bak

# ===========================
# Build artifacts (汎用)
# ===========================
build/
dist/
*.log

# ===========================
# AI 生成アセット中間ファイル (公開対象外、最終版のみコミット)
# ===========================
art/_intermediate/
audio/_intermediate/
3d/_intermediate/

# MCP client config.
# Keep machine-resolved local paths out of git; track only .example templates.
/.mcp.json
/.codex/config.toml

# Cloudflare wrangler local state (created by tools/r2 review uploads).
/.wrangler/

# Paid Asset Store assets — DO NOT commit to this public repo (EULA: no public
# redistribution of paid asset source). Each environment imports from its own
# Asset Store account. See docs/HD2D_PHASE_B_C_BETA_HANDOFF.md.
/Assets/FronkonGames/
/Assets/FronkonGames.meta
/Packages/com.occasoftware.buto/

# ===========================
# Procedurally generated scene (build artifact of
# Assets/Editor/AnemoraFastVsHouseSliceSetup.cs).
# Regenerate: Unity menu Anemora/Fast VS/Create House Slice
# or -executeMethod AnemoraFastVsHouseSliceSetup.CreateHouseSliceScene
# ===========================
/Assets/Scenes/Anemora_FastVS_HouseSlice.unity
/Assets/Scenes/Anemora_FastVS_HouseSlice.unity.meta

# ===========================
# Adaptive Probe Volume / lighting bake output (regenerated by a bake).
# Keep the BakingSet.asset settings as source; ignore only the *.bytes payloads + .meta.
# ===========================
/Assets/Settings/*.CellData.bytes
/Assets/Settings/*.CellData.bytes.meta
/Assets/Settings/*.CellOptionalData.bytes
/Assets/Settings/*.CellOptionalData.bytes.meta
/Assets/Settings/*.CellProbeOcclusionData.bytes
/Assets/Settings/*.CellProbeOcclusionData.bytes.meta
/Assets/Settings/*.CellBricksData.bytes
/Assets/Settings/*.CellBricksData.bytes.meta
/Assets/Settings/*.CellSharedData.bytes
/Assets/Settings/*.CellSharedData.bytes.meta
/Assets/Settings/*.CellSupportData.bytes
/Assets/Settings/*.CellSupportData.bytes.meta

# Legacy GI bake folders (in case a scene bakes lightmaps later)
/[Aa]ssets/**/LightingData.asset
/[Aa]ssets/**/Lightmap-*.exr
/[Aa]ssets/**/Lightmap-*.png
/[Aa]ssets/**/ReflectionProbe-*.exr

# ===========================
# Ephemeral review / devlog imagery -> Cloudflare R2 (see tools/r2/).
# Kept in a never-pruned local archive; never tracked in git.
# ===========================
/docs/review/
/docs/devlog/screenshots/
