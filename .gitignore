# ===========================
build/
dist/
*.log

# ===========================
# AI 生成アセット中間ファイル (公開対象外、最終版のみコミット)
# ===========================
art/_intermediate/
audio/_intermediate/
3d/_intermediate/

# MCP client config.
# Keep machine-resolved local paths out of git; track only .example templates.
/.mcp.json
/.codex/config.toml

