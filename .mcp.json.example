{
  "_comment": "Template only. Copy to .mcp.json, run the Server~ npm build, and replace RESOLVED_HASH per tools/mcp/SETUP.md. The concrete .mcp.json is gitignored (machine-resolved path under Library/).",
  "mcpServers": {
    "mcp-unity": {
      "command": "node",
      "args": [
        "Library/PackageCache/com.gamelovers.mcp-unity@RESOLVED_HASH/Server~/build/index.js"
      ]
    }
  }
}
