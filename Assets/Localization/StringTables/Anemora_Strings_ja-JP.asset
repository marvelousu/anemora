    m_Localized: "\u8AB0\u304B\u304C\u6B8B\u3057\u305F\u306F\u305A\u306E\u9053\u306A\u306E\u306B\u3001\u6B69\u304F\u305F\u3073\u3001\u5C11\u3057\u305A\u3064\u9060\u304F\u306A\u308B\u3002"
