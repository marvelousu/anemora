#!/usr/bin/env bash
# Repo-hygiene pre-push guard. Inspects EVERY commit in each pushed range
# (not just the endpoints), sizing files from each commit's own blobs, so
# transient bloat added then removed mid-range is still caught.
set -euo pipefail
DIR="$(git rev-parse --show-toplevel)/tools/githooks"
fail=0
ZERO=0000000000000000000000000000000000000000

while read -r _lref lsha _rref rsha; do
  [ "$lsha" = "$ZERO" ] && continue   # branch deletion -> nothing to scan
  if [ "$rsha" = "$ZERO" ]; then
    # new remote branch: commits not yet on any remote-tracking ref
    commits=$(git rev-list "$lsha" --not --remotes 2>/dev/null || true)
    [ -z "$commits" ] && commits="$lsha"
  else
    commits=$(git rev-list "$rsha..$lsha")
  fi
  for c in $commits; do
    export REV="$c" SIZE_SRC=rev
    git diff-tree --no-commit-id --name-only -r --diff-filter=AM "$c" \
      | bash "$DIR/_bloat_check.sh" || fail=1
  done
done

[ "$fail" = 0 ] || { echo "pre-push: bloat guard FAILED (override only in emergencies: git push --no-verify)." >&2; exit 1; }

# Devlog/review discipline guard: implementation/workflow commits need a devlog,
# new devlogs need INDEX, and recent local review cycles need devlog.txt + images.
# Override for emergencies: ANEMORA_SKIP_REVIEW_SYNC_CHECK=1 git push ...
if [ "${ANEMORA_SKIP_REVIEW_SYNC_CHECK:-0}" != "1" ]; then
  ROOT="$(git rev-parse --show-toplevel)"
  if command -v pwsh >/dev/null 2>&1; then
    PS_BIN=pwsh
  elif command -v powershell.exe >/dev/null 2>&1; then
    PS_BIN=powershell.exe
  elif command -v powershell >/dev/null 2>&1; then
    PS_BIN=powershell
  else
    echo "pre-push: PowerShell not found; cannot run review sync guard." >&2
    exit 1
  fi
  "$PS_BIN" -NoProfile -ExecutionPolicy Bypass -File "$ROOT/tools/review/validate-devlog-review-sync.ps1" || {
    echo "pre-push: review/devlog sync guard FAILED (override: ANEMORA_SKIP_REVIEW_SYNC_CHECK=1 git push ...)." >&2
    exit 1
  }
fi

# STATUS freshness guard: pushing work whose docs/STATUS.md is >7 days older than
# HEAD usually means the frontier doc has drifted (2026-06-13: 3-week drift incident).
# Override for emergencies: ANEMORA_SKIP_STATUS_CHECK=1 git push ...
if [ "${ANEMORA_SKIP_STATUS_CHECK:-0}" != "1" ]; then
  status_ts=$(git log -1 --format=%ct -- docs/STATUS.md 2>/dev/null || echo 0)
  head_ts=$(git log -1 --format=%ct HEAD 2>/dev/null || echo 0)
  if [ "$status_ts" -gt 0 ] && [ "$head_ts" -gt 0 ] && [ $((head_ts - status_ts)) -gt $((7*24*3600)) ]; then
    echo "pre-push: docs/STATUS.md is >7 days older than HEAD — update the frontier in STATUS.md first." >&2
    echo "pre-push: (override: ANEMORA_SKIP_STATUS_CHECK=1 git push ...)" >&2
    exit 1
  fi
fi
